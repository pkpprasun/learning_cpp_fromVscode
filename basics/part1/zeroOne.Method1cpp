#include<iostream>
using namespace std;
int main(){
int n;
int val=5;
cout<<"enter a number "<<endl;
// cin>>n;
n=4;

for(int i = 1 ; i<=n;i++)
{
    if(i%2!=0){
         val=1;
    }
    else val = 0;

    for(int j = 1 ; j<=i;j++){

         cout<<val;
        //after printing flip it
        if(val==1) {val=0;}
        else val=1;
    }

    cout<<endl;
}

return 0;

}